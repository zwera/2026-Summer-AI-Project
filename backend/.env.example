# ============================================================
# 경찰관 공무집행 적법성 검증 봇 - 환경변수 템플릿
# 이 파일을 복사해서 .env 로 저장하고 값을 채워주세요.
# (.env 파일은 git에 커밋되지 않습니다)
# ============================================================

# --- Google Gemini API ---
# https://aistudio.google.com/apikey 에서 발급받은 키를 입력하세요.
GEMINI_API_KEY=

# 사용할 Gemini 모델 (기본값: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --- ChromaDB (로컬 파일 기반, 별도 서버 불필요) ---
CHROMA_PERSIST_DIR=./chroma_data

# --- 임베딩 / 리랭커 모델 (로컬 GPU 사용) ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-large
EMBEDDING_DEVICE=cuda

# --- FastAPI 서버 ---
API_HOST=127.0.0.1
API_PORT=8000

# --- 프론트엔드에서 백엔드 API를 바라볼 주소 (CORS 허용용) ---
FRONTEND_ORIGIN=http://localhost:5173
