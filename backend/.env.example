# ============================================================
# 경찰관 공무집행 적법성 검증 봇 - 환경변수 템플릿
# 이 파일을 복사해서 .env 로 저장하고 값을 채워주세요.
# (.env 파일은 git에 커밋되지 않습니다)
# ============================================================

# --- Google Gemini API ---
# https://aistudio.google.com/apikey 에서 발급받은 키를 입력하세요.
GEMINI_API_KEY=

# 사용할 Gemini 모델.
# 주의: 신규 발급 API 키에서는 "gemini-2.5-flash" 같은 구체적 버전명이
# 404(no longer available to new users)로 막히는 경우가 있습니다.
# 이 경우 별칭(latest) 모델을 사용하세요. 무료 티어는 모델별로 일일 호출
# 한도가 있으니(예: 하루 20회) 한도에 걸리면 다른 별칭으로 바꿔보세요.
#   후보: gemini-flash-lite-latest, gemini-flash-latest, gemini-2.0-flash
GEMINI_MODEL=gemini-flash-lite-latest

# --- ChromaDB (로컬 파일 기반, 별도 서버 불필요) ---
# 주의: 이 프로젝트 경로 자체가 한글(비-ASCII)을 포함하면 ChromaDB가 쓰는
# hnswlib(C++ 확장모듈)이 벡터 인덱스 파일을 조용히 못 여는 문제가 있습니다.
# 프로젝트 폴더 경로에 한글이 있다면, 아래 경로를 사용자 홈 등 영문 경로로
# 바꿔서 사용하세요. 예) Windows: C:/Users/사용자명/.police_bot_chroma_data
#                      macOS/Linux: /home/사용자명/.police_bot_chroma_data
CHROMA_PERSIST_DIR=./chroma_data

# --- 임베딩 / 리랭커 모델 (로컬 GPU 사용) ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-large
# GPU(CUDA)가 없다면 cpu로 바꾸세요. (속도는 느려지지만 동작은 합니다)
EMBEDDING_DEVICE=cuda

# --- FastAPI 서버 ---
API_HOST=127.0.0.1
API_PORT=8000

# --- 프론트엔드에서 백엔드 API를 바라볼 주소 (CORS 허용용) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- 국가법령정보센터 Open API 인증키 (선택, 판례 추가 수집 시에만 필요) ---
# https://open.law.go.kr 회원가입 후 이용 신청. 값은 가입 이메일의 '@' 앞부분입니다.
LAW_OC=
